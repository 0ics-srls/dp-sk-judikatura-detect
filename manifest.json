{
  "specVersion": "1.1",
  "type": "stdin",
  "name": "dp-sk-judikatura-detect",
  "version": "0.1.0",
  "description": "Turns an nsud-decisions Source config into catalog items: one per month of decision dates, or one for explicit ids. No network. Proc-protocol v1.1: spec, check, run.",
  "author": "open-lex-it",
  "authentication": false,
  "actions": {
    "spec": {
      "description": "Return the config and output JSON schemas (Proc-protocol 1.1).",
      "input": { "type": "object", "properties": {} },
      "output": {
        "type": "object",
        "properties": {
          "configSchema": { "type": "object" },
          "outputSchema": { "type": "object" },
          "protocol": { "type": "string", "const": "1.1" }
        }
      }
    },
    "check": {
      "description": "Test Source: validates the config (year range, ids, sample filters). No request is made; grab finds out what a month holds.",
      "input": { "type": "object", "properties": {} },
      "output": { "type": "object", "properties": { "ok": { "type": "boolean" } } }
    },
    "run": {
      "description": "Items are the months whose key is not in state.seen; a refreshToken change re-emits every item.",
      "input": {
        "type": "object",
        "properties": {
          "annoFrom": { "type": "integer" },
          "annoTo": { "type": "integer" },
          "ids": { "type": "array", "items": { "type": "string" } },
          "maxDocs": { "type": "integer" },
          "includePdfOnly": { "type": "boolean" },
          "verifyTls": { "type": "boolean" },
          "delaySeconds": { "type": "number" },
          "baseUrl": { "type": "string" },
          "refreshToken": { "type": ["string", "null"] },
          "state": {
            "type": ["object", "null"],
            "properties": { "seen": { "type": "array", "items": { "type": "string" } } }
          }
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "items": { "type": "array" },
          "state": { "type": "object" },
          "metrics": { "type": "object" },
          "checks": { "type": "array" }
        }
      }
    },
    "execute": {
      "description": "Alias of run for Proc-protocol v1 callers (ProcMon mandates execute); same input and result as run.",
      "input": { "type": "object", "properties": {} },
      "output": {
        "type": "object",
        "properties": {
          "items": { "type": "array" },
          "state": { "type": "object" },
          "metrics": { "type": "object" },
          "checks": { "type": "array" }
        }
      }
    },
    "terminate": {
      "description": "Stop and clean up.",
      "input": { "type": "object", "properties": {} }
    }
  },
  "execution": {
    "timeout": 600,
    "memoryLimit": "256Mi",
    "cpuLimit": "0.5"
  }
}
